{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-registry/registry.schema.json",
  "title": "Engineering Research Capability Registry",
  "description": "Format 1.0. resolver.py validate_registry() enforces the same required fields and enums with the standard library; a test keeps the two in step.",
  "type": "object",
  "required": ["registry_format", "last_updated", "entries"],
  "properties": {
    "registry_format": {"const": "1.0"},
    "description": {"type": "string"},
    "last_updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "tag": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "entry": {
      "type": "object",
      "required": ["id", "name", "type", "purpose", "status", "source", "install",
                   "capabilities", "limitations", "trust", "last_reviewed"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/tag"},
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["skill", "plugin", "connector", "github_repo", "api", "mcp", "cli",
                          "internal_tool"]},
        "purpose": {"type": "string", "minLength": 1},
        "status": {"enum": ["released", "available", "in_development", "deprecated"]},
        "source": {
          "type": "object",
          "required": ["location"],
          "properties": {
            "location": {"type": "string", "minLength": 1},
            "path": {"type": "string"},
            "ref": {"type": "string"}
          }
        },
        "install": {
          "type": "object",
          "required": ["method", "instructions"],
          "properties": {
            "method": {"enum": ["plugin", "repo_checkout", "connector", "mcp_config", "api_key",
                                "cli_install", "none"]},
            "instructions": {"type": "string"}
          }
        },
        "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tag"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "trust": {"type": "string", "minLength": 1},
        "last_reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    }
  }
}
